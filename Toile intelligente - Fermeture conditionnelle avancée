blueprint:
  name: Toile intelligente - Fermeture au coucher du soleil
  description: >
    Ferme une toile après le coucher du soleil.
    Si la fenêtre est ouverte, la toile se positionne à une ouverture configurable.
    Sinon, elle se ferme complètement.

  domain: automation

  input:
    cover_entity:
      name: Toile
      selector:
        entity:
          domain: cover

    window_sensor:
      name: Fenêtre associée
      selector:
        entity:
          domain: binary_sensor

    sunset_offset:
      name: Décalage du coucher du soleil
      description: |
        Exemples :
        01:00:00 = 1 heure après
        00:30:00 = 30 minutes après
        -00:15:00 = 15 minutes avant
      default: "01:00:00"
      selector:
        text:

    partial_position:
      name: Position si fenêtre ouverte
      description: |
        0 = fermé complètement
        100 = ouvert complètement

        Exemple :
        25 = fermeture à 75 %
      default: 25
      selector:
        number:
          min: 0
          max: 100
          step: 1
          mode: slider

trigger:
  - platform: sun
    event: sunset
    offset: !input sunset_offset

condition: []

action:
  - if:
      - condition: state
        entity_id: !input window_sensor
        state: "on"
    then:
      - service: cover.set_cover_position
        target:
          entity_id: !input cover_entity
        data:
          position: !input partial_position
    else:
      - service: cover.close_cover
        target:
          entity_id: !input cover_entity

mode: single
