blueprint:
  name: Toile intelligente
  description: Ferme une toile complètement ou partiellement si une fenêtre est ouverte.
  domain: automation

  input:
    cover_entity:
      name: Toile
      selector:
        entity:
          domain: cover

    window_sensor:
      name: Fenêtre
      selector:
        entity:
          domain: binary_sensor

    partial_position:
      name: Position si fenêtre ouverte
      description: |
        0 = fermé
        100 = ouvert
        Exemple : 25 = fermé à 75 %
      default: 25
      selector:
        number:
          min: 0
          max: 100
          step: 1

    trigger_time:
      name: Heure de fermeture
      selector:
        time:

    sunset_offset:
      name: Décalage après coucher du soleil
      default: "01:00:00"
      selector:
        text:

trigger:
  - platform: time
    at: !input trigger_time

trigger:
  - platform: sun
    event: sunset
    offset: !input sunset_offset

action:
  - if:
      - condition: state
        entity_id: !input window_sensor
        state: "on"
    then:
      - service: cover.set_cover_position
        target:
          entity_id: !input cover_entity
        data:
          position: !input partial_position
    else:
      - service: cover.close_cover
        target:
          entity_id: !input cover_entity

mode: single
