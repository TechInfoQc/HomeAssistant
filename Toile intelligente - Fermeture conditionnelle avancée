blueprint:
  name: Toile intelligente - Fermeture conditionnelle avancée
  description: >
    Ferme une toile selon un horaire configurable.

    Fonctionnalités :
      - Heure fixe OU coucher du soleil avec décalage
      - Fermeture complète ou partielle si la fenêtre est ouverte
      - Possibilité de ne rien faire si la fenêtre est ouverte
      - Délai avant fermeture

  domain: automation

  input:

    cover_entity:
      name: Toile
      selector:
        entity:
          domain: cover

    window_sensor:
      name: Fenêtre associée
      selector:
        entity:
          domain: binary_sensor

    trigger_mode:
      name: Mode de déclenchement
      description: Choisir entre coucher du soleil ou heure fixe
      default: sunset
      selector:
        select:
          options:
            - sunset
            - time

    sunset_offset:
      name: Décalage après le coucher du soleil
      description: Exemple 01:00:00 = 1 heure après le coucher du soleil
      default: "01:00:00"
      selector:
        text:

    close_time:
      name: Heure fixe
      default: "22:00:00"
      selector:
        time:

    window_behavior:
      name: Comportement si la fenêtre est ouverte
      description: >
        partial = fermeture partielle
        full = fermeture complète
        skip = aucune action
      default: partial
      selector:
        select:
          options:
            - partial
            - full
            - skip

    partial_position:
      name: Position si fermeture partielle
